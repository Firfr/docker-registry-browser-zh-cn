<footer class="fixed-bottom bg-light border-top p-4">
  <div class="container text-center text-dark-50 small">
    <div class="d-flex justify-content-between">
      <div>
        <%= image_tag "icons/docker-footer.png", size: "16x16" %>
        <a href="https://github.com/klausmeyer/docker-registry-browser" class="text-reset">Docker 仓库浏览器</a>
        &middot;
        版本 <%= Rails.application.config.x.version %>
      </div>
      <div>
        <%= image_tag "icons/ruby.png", size: "16x16" %>
        运行在 Ruby <%= RUBY_VERSION %> 以及 Rails <%= Rails.version %> 环境， <%= Rails.env %> 模式下
      </div>
      <div>
        <%= image_tag "icons/icons8.png", size: "16x16" %>
        图标来自 <a href="https://icons8.com" class="text-reset">icons8.com</a>
      </div>
    </div>
  </div>
</footer>
