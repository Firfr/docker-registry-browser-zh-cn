<% if @repositories.any? %>
  <% @namespaces.each do |namespace, repositories| %>
    <%= render "namespace", namespace: namespace, repositories: repositories %>
  <% end %>
<% else %>
  <div class="card-body text-center py-5">
    <h2>仓库为空</h2>
    <h4 class="lead text-muted">当前镜像仓库中没有仓库。</h4>
  </div>
<% end %>
